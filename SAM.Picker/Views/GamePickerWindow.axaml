<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SAM.Picker.ViewModels"
        xmlns:local="using:SAM.Picker"
        x:Class="SAM.Picker.Views.GamePickerWindow"
        x:DataType="vm:GamePickerViewModel"
        Icon="/SAM.ico"
        Width="1020" Height="600"
        MinWidth="420" MinHeight="320"
        Title="Steam Achievement Manager 7.0 | Pick a game... Any game...">

  <Window.Resources>
    <!-- Drawn rather than shipped as PNGs: the Fugue set used elsewhere has no
         grid/list glyph, and a PathIcon inherits the theme foreground so it
         stays legible in both light and dark, which the bitmap icons do not. -->
    <StreamGeometry x:Key="TilesIcon">M1,1 H7 V7 H1 Z M9,1 H15 V7 H9 Z M1,9 H7 V15 H1 Z M9,9 H15 V15 H9 Z</StreamGeometry>
    <StreamGeometry x:Key="ContentIcon">M1,2 H5 V6 H1 Z M7,3 H15 V5 H7 Z M1,9 H5 V13 H1 Z M7,10 H15 V12 H7 Z</StreamGeometry>
    <StreamGeometry x:Key="SortIcon">M2,3 H14 V5 H2 Z M2,7 H10 V9 H2 Z M2,11 H6 V13 H2 Z</StreamGeometry>
    <StreamGeometry x:Key="SettingsIcon">M8,5.6 A2.4,2.4 0 1 0 8,10.4 A2.4,2.4 0 1 0 8,5.6 Z M7,0.8 H9 L9.35,2.75 A5.4,5.4 0 0 1 10.8,3.6 L12.65,2.9 L13.65,4.65 L12.15,5.95 A5.4,5.4 0 0 1 12.15,10.05 L13.65,11.35 L12.65,13.1 L10.8,12.4 A5.4,5.4 0 0 1 9.35,13.25 L9,15.2 H7 L6.65,13.25 A5.4,5.4 0 0 1 5.2,12.4 L3.35,13.1 L2.35,11.35 L3.85,10.05 A5.4,5.4 0 0 1 3.85,5.95 L2.35,4.65 L3.35,2.9 L5.2,3.6 A5.4,5.4 0 0 1 6.65,2.75 Z</StreamGeometry>
    <StreamGeometry x:Key="AscendingIcon">M8,2 L13,9 H9.5 V14 H6.5 V9 H3 Z</StreamGeometry>
    <StreamGeometry x:Key="DescendingIcon">M8,14 L3,7 H6.5 V2 H9.5 V7 H13 Z</StreamGeometry>
    <StreamGeometry x:Key="LikeIcon">M4,14 V7 H2 V14 Z M6,14 H12 L14,8 V7 H9.5 L10,4 A1.2,1.2 0 0 0 8.5,2.5 L6,7 Z</StreamGeometry>
    <StreamGeometry x:Key="DislikeIcon">M4,2 V9 H2 V2 Z M6,2 H12 L14,8 V9 H9.5 L10,12 A1.2,1.2 0 0 1 8.5,13.5 L6,9 Z</StreamGeometry>

    <!-- Explicit colours rather than theme accents: these need to read as
         positive/negative at a glance, and both work on light and dark. -->
    <SolidColorBrush x:Key="RatingLikeBrush" Color="#2E9E4F" />
    <SolidColorBrush x:Key="RatingDislikeBrush" Color="#D0453B" />

  </Window.Resources>

  <DockPanel>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top"
            Padding="6,4"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <!-- Wraps rather than clips: with the view-mode toggles added, a fixed
           row runs off the right edge on a narrow window and the last button
           becomes unreachable. -->
      <WrapPanel Orientation="Horizontal">
        <WrapPanel.Styles>
          <Style Selector="WrapPanel > :is(Control)">
            <Setter Property="Margin" Value="0,0,6,0" />
          </Style>
        </WrapPanel.Styles>

        <Button Command="{Binding RefreshCommand}"
                IsEnabled="{Binding CanRefresh}"
                ToolTip.Tip="Refresh the list of owned games">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image Source="/Resources/arrow-circle-double.png" Width="16" Height="16" />
            <TextBlock Text="Refresh Games" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Rectangle Width="1" Margin="2,2"
                   Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />

        <TextBox Text="{Binding AddGameText}"
                 Width="110"
                 PlaceholderText="App ID"
                 VerticalAlignment="Center">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding AddGameByIdCommand}" />
          </TextBox.KeyBindings>
        </TextBox>

        <Button Command="{Binding AddGameByIdCommand}"
                ToolTip.Tip="Show a single game by its app ID">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image Source="/Resources/magnifier.png" Width="16" Height="16" />
            <TextBlock Text="Add Game" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Rectangle Width="1" Margin="2,2"
                   Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />

        <TextBlock Text="Filter" VerticalAlignment="Center" />

        <TextBox Text="{Binding SearchText}"
                 Width="160"
                 PlaceholderText="Search by name"
                 VerticalAlignment="Center" />

        <Button ToolTip.Tip="Game filtering">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Spacing="6" Margin="4">
                <CheckBox IsChecked="{Binding ShowGames}" Content="Show _games" />
                <CheckBox IsChecked="{Binding ShowDemos}" Content="Show _demos" />
                <CheckBox IsChecked="{Binding ShowMods}" Content="Show _mods" />
                <CheckBox IsChecked="{Binding ShowJunk}" Content="Show _junk" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
          <Image Source="/Resources/television-test.png" Width="16" Height="16" />
        </Button>

        <Rectangle Width="1" Margin="2,2"
                   Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />

        <!-- Primary half shows the active mode and flips to the other on click;
             the drop-down half selects a mode explicitly. -->
        <ToggleSplitButton IsChecked="{Binding IsContentView}"
                           ToolTip.Tip="Click to switch view; use the arrow to pick one">
          <Panel>
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsTileView}">
              <PathIcon Data="{StaticResource TilesIcon}" Width="14" Height="14" />
              <TextBlock Text="Tiles" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsContentView}">
              <PathIcon Data="{StaticResource ContentIcon}" Width="14" Height="14" />
              <TextBlock Text="Content" VerticalAlignment="Center" />
            </StackPanel>
          </Panel>
          <ToggleSplitButton.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Header="Tiles"
                        Command="{Binding ShowTilesCommand}"
                        ToolTip.Tip="Large capsule art with the game name">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource TilesIcon}" Width="14" Height="14" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Content"
                        Command="{Binding ShowContentCommand}"
                        ToolTip.Tip="Rows with playtime and achievement counts">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource ContentIcon}" Width="14" Height="14" />
                </MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </ToggleSplitButton.Flyout>
        </ToggleSplitButton>

        <SplitButton Command="{Binding ToggleSortDirectionCommand}"
                     ToolTip.Tip="Click to reverse the order; use the arrow to choose a field">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource SortIcon}" Width="14" Height="14" />
            <TextBlock Text="{Binding SortDescriptionText}" VerticalAlignment="Center" />
            <PathIcon Width="10" Height="10"
                      Data="{StaticResource AscendingIcon}"
                      IsVisible="{Binding !SortDescending}" />
            <PathIcon Width="10" Height="10"
                      Data="{StaticResource DescendingIcon}"
                      IsVisible="{Binding SortDescending}" />
          </StackPanel>
          <SplitButton.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Header="Name"
                        Command="{Binding SortByCommand}"
                        CommandParameter="{x:Static local:GameSortField.Name}" />
              <MenuItem Header="Release date"
                        Command="{Binding SortByCommand}"
                        CommandParameter="{x:Static local:GameSortField.ReleaseDate}" />
              <MenuItem Header="Last played"
                        Command="{Binding SortByCommand}"
                        CommandParameter="{x:Static local:GameSortField.LastPlayed}" />
              <MenuItem Header="Steam rating"
                        Command="{Binding SortByCommand}"
                        CommandParameter="{x:Static local:GameSortField.SteamRating}" />
              <MenuItem Header="My rating"
                        Command="{Binding SortByCommand}"
                        CommandParameter="{x:Static local:GameSortField.OwnRating}" />
              <Separator />
              <MenuItem Header="Reverse order" Command="{Binding ToggleSortDirectionCommand}" />
            </MenuFlyout>
          </SplitButton.Flyout>
        </SplitButton>

        <Rectangle Width="1" Margin="2,2"
                   Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />

        <Button Command="{Binding OpenSettingsCommand}"
                ToolTip.Tip="Where the game and icon caches are kept">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource SettingsIcon}" Width="14" Height="14" />
            <TextBlock Text="Settings" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

      </WrapPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom"
            Padding="8,4"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="6"
                    IsVisible="{Binding IsDownloadStatusVisible}">
          <Image Source="/Resources/download-cloud.png" Width="16" Height="16" />
          <TextBlock Text="{Binding DownloadStatusText}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding StatusText}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- Tile view -->
    <ListBox Name="_GameTileBox"
             IsVisible="{Binding IsTileView}"
             ItemsSource="{Binding FilteredGames}"
             SelectedItem="{Binding SelectedGame}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             DoubleTapped="OnGameDoubleTapped"
             KeyDown="OnGameListKeyDown">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="local:GameInfo">
          <StackPanel Width="200" Margin="4" Spacing="4">
            <Border Height="80"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    CornerRadius="3">
              <Image Source="{Binding Logo}" Stretch="Uniform" />
            </Border>
            <TextBlock Text="{Binding Name}"
                       TextWrapping="Wrap"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Content view -->
    <DockPanel IsVisible="{Binding IsContentView}">
      <Border DockPanel.Dock="Top"
              Padding="6,0"
              Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
        <!-- NOTE: these column widths must match the row template below. -->
        <Grid ColumnDefinitions="56,*,110,110,90,110,80">
          <!-- Headers double as sort controls; clicking the active one reverses. -->
          <Grid.Styles>
            <Style Selector="Button.header">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Padding" Value="4,6" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
          </Grid.Styles>

          <Button Grid.Column="1" Classes="header"
                  Command="{Binding SortByCommand}"
                  CommandParameter="{x:Static local:GameSortField.Name}"
                  Content="Name" />
          <Button Grid.Column="2" Classes="header"
                  Command="{Binding SortByCommand}"
                  CommandParameter="{x:Static local:GameSortField.ReleaseDate}"
                  Content="Released" />
          <Button Grid.Column="3" Classes="header"
                  Command="{Binding SortByCommand}"
                  CommandParameter="{x:Static local:GameSortField.LastPlayed}"
                  Content="Last played" />
          <Button Grid.Column="4" Classes="header"
                  Command="{Binding SortByCommand}"
                  CommandParameter="{x:Static local:GameSortField.SteamRating}"
                  Content="Steam" />
          <TextBlock Grid.Column="5" Text="Achievements"
                     FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0" />
          <Button Grid.Column="6" Classes="header"
                  Command="{Binding SortByCommand}"
                  CommandParameter="{x:Static local:GameSortField.OwnRating}"
                  Content="Mine" />
        </Grid>
      </Border>

      <ListBox Name="_GameContentBox"
               ItemsSource="{Binding FilteredGames}"
               SelectedItem="{Binding SelectedGame}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               DoubleTapped="OnGameDoubleTapped"
               KeyDown="OnGameListKeyDown">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:GameInfo">
            <Grid ColumnDefinitions="56,*,110,110,90,110,80" MinHeight="34">
              <Border Grid.Column="0"
                      Width="48" Height="22"
                      HorizontalAlignment="Left"
                      Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                      CornerRadius="2">
                <Image Source="{Binding Logo}" Stretch="Uniform" />
              </Border>
              <TextBlock Grid.Column="1"
                         Text="{Binding Name}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Margin="4,0" />
              <TextBlock Grid.Column="2"
                         Text="{Binding ReleaseDateText}"
                         VerticalAlignment="Center"
                         Margin="4,0" />
              <TextBlock Grid.Column="3"
                         Text="{Binding LastPlayedText}"
                         VerticalAlignment="Center"
                         Margin="4,0"
                         ToolTip.Tip="{Binding PlaytimeText}" />
              <TextBlock Grid.Column="4"
                         Text="{Binding SteamRatingText}"
                         VerticalAlignment="Center"
                         TextAlignment="Right"
                         Margin="4,0"
                         ToolTip.Tip="{Binding SteamRatingTooltip}" />
              <TextBlock Grid.Column="5"
                         Text="{Binding AchievementsText}"
                         VerticalAlignment="Center"
                         TextAlignment="Right"
                         Margin="4,0" />
              <!-- Plain Buttons with a bound style class rather than
                   ToggleButtons: the rating is owned by the view model, and a
                   ToggleButton flips its own IsChecked on click, which fights
                   the binding and leaves the displayed state out of sync with
                   what was actually saved. -->
              <StackPanel Grid.Column="6"
                          Orientation="Horizontal"
                          Spacing="2"
                          VerticalAlignment="Center"
                          Margin="4,0">
                <StackPanel.Styles>
                  <Style Selector="Button.liked PathIcon">
                    <Setter Property="Foreground" Value="{StaticResource RatingLikeBrush}" />
                  </Style>
                  <Style Selector="Button.disliked PathIcon">
                    <Setter Property="Foreground" Value="{StaticResource RatingDislikeBrush}" />
                  </Style>
                  <Style Selector="Button:not(.liked):not(.disliked) PathIcon">
                    <Setter Property="Opacity" Value="0.45" />
                  </Style>
                </StackPanel.Styles>

                <Button Classes.liked="{Binding IsLiked}"
                        Padding="5,3"
                        ToolTip.Tip="I like this game (saved locally by SAM, never sent to Steam)"
                        Command="{Binding $parent[ListBox].((vm:GamePickerViewModel)DataContext).ToggleLikeCommand}"
                        CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource LikeIcon}" Width="12" Height="12" />
                </Button>
                <Button Classes.disliked="{Binding IsDisliked}"
                        Padding="5,3"
                        ToolTip.Tip="I do not like this game (saved locally by SAM, never sent to Steam)"
                        Command="{Binding $parent[ListBox].((vm:GamePickerViewModel)DataContext).ToggleDislikeCommand}"
                        CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource DislikeIcon}" Width="12" Height="12" />
                </Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

  </DockPanel>
</Window>
