<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyTitle>Steam Achievement Manager Picker</AssemblyTitle>
    <Company>Gibbed</Company>
    <Authors>Gibbed</Authors>
    <Description>A game picker for the Steam Achievement Manager.</Description>
    <Copyright>Copyright © Gibbed 2019</Copyright>
  </PropertyGroup>
  <PropertyGroup>
    <Version>8.0.0</Version>
    <AssemblyVersion>8.0.0.0</AssemblyVersion>
    <FileVersion>8.0.0.0</FileVersion>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>SAM.ico</ApplicationIcon>
    <!-- The manifest only means anything to the Windows loader. -->
    <ApplicationManifest Condition="'$(RuntimeIdentifier)'=='' or $(RuntimeIdentifier.StartsWith('win'))">app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup>
    <RepositoryUrl>https://github.com/gibbed/SteamAchievementManager/</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Platforms>x86;AnyCPU</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- x86 gets its own directory. With a pinned RID the native Skia/HarfBuzz
         libraries are copied flat next to the exe rather than into
         runtimes/<rid>/, so an x86 and an x64 build sharing one output folder
         silently overwrite each other's natives and the survivor crashes on
         startup with an architecture mismatch. -->
    <OutputPath Condition="'$(Platform)'=='x86'">..\bin\x86\</OutputPath>
    <OutputPath Condition="'$(Platform)'!='x86'">..\bin\</OutputPath>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Every target SAM can be published for. Only the x86/x64 ones can
         actually load Steam's client; see SteamPlatform for why the ARM ones
         are built but report an explanatory error at startup. -->
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <!-- SAM is Windows-only (registry lookup + steamclient.dll), so pin a RID.
       Without one, a framework-dependent build copies every RID's native
       assets that Avalonia/Skia ship - Linux, musl, macOS, Android, riscv -
       which came to over 500 MB in bin\ and made the release artifact
       useless. AppendRuntimeIdentifierToOutputPath keeps bin\ flat, which
       matters because SAM.Game.exe and SAM.Picker.exe launch each other by
       path from the same directory. -->
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(Platform)'=='x86' and $([MSBuild]::IsOSPlatform('Windows'))">win-x86</RuntimeIdentifier>
    <!-- Default to the host's own RID, not a hardcoded win-x64: an explicit -r
         on the command line still wins, but a plain `dotnet build` on Linux or
         macOS must produce an apphost for *that* machine. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'==''">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>True</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="'$(Configuration)'=='Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.1" />
    <!-- Pinned ahead of the version Microsoft.Data.Sqlite pulls in: that one is
         SQLitePCLRaw 2.1.11, which carries GHSA-2m69-gcr7-jv3q. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="SAM.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- The icon set and its sizing style, shared with the other application so
         both toolbars cannot drift apart. Linked to Resources/ so the avares
         path is the same in both assemblies. -->
    <AvaloniaResource Include="..\Shared\Icons.axaml" Link="Resources\Icons.axaml" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared with the other application: both processes read the same
         ~/.sam/settings.json and write into the same icon directory. Linked
         rather than moved into SAM.API, which stays package-free. -->
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SAM.API\SAM.API.csproj" />
  </ItemGroup>
</Project>
